{
  "name": "@codewavebr/wavecalendar",
  "version": "0.2.3",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/codewavebr/wavecalendar.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./dialogs": {
      "types": "./dist/dialogs/index.d.ts",
      "import": "./dist/dialogs/index.js"
    },
    "./dnd": {
      "types": "./dist/dnd/index.d.ts",
      "import": "./dist/dnd/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces.d.ts",
      "import": "./dist/interfaces.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    },
    "./mutations": {
      "types": "./dist/mutations.d.ts",
      "import": "./dist/mutations.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "import": "./dist/slots.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "link:wavekit": "node ./scripts/link-wavekit.mjs",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@codewavebr/wavekit": "^0.2.5",
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "@hookform/resolvers": "^5.0.0",
    "date-fns": "^4.0.0",
    "lucide-react": "^0.511.0",
    "react": ">=19",
    "react-dnd": "^16.0.0",
    "react-dnd-html5-backend": "^16.0.0",
    "react-dom": ">=19",
    "react-hook-form": "^7.0.0",
    "tailwindcss": ">=4.0.0",
    "zod": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@codewavebr/wavekit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codewavebr/wavekit": "^0.2.5",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@hookform/resolvers": "^5.0.0",
    "@types/node": "^20.9.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dnd": "^16.0.0",
    "react-dnd-html5-backend": "^16.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.2.2",
    "zod": "^3.25.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1"
  }
}
